# Copy to .env for local-only use. Never commit real values.

# Browser-safe values may be mirrored into web/js/config.js for local frontend use.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_BROWSER_SAFE_ANON_KEY

# PRIVILEGED: local ingestion/analytics only. Never expose in frontend or CI logs.
SUPABASE_SERVICE_ROLE_KEY=LOCAL_ONLY_SERVICE_ROLE_KEY

# Local Ollama only. Do not bind or expose this endpoint publicly.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Ingestion safety controls
MAX_DOCUMENT_BYTES=26214400
ALLOWED_DOCUMENT_MIME_TYPES=application/pdf,text/plain
